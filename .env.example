# ─────────────────────────────────────────────────────────────────────────────
# Gather settings. Copy to .env:   cp .env.example .env
# Everything optional can stay empty: the app still runs fully on your computer.
# ─────────────────────────────────────────────────────────────────────────────

# Where the app is opened in the browser
APP_URL=http://localhost:8080
PORT=8080

# Secrets: change both to long random strings before going live
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CODE_SECRET=change-me-too-another-long-random-string

# Show sign-in codes in the server log as well as by email (handy locally; set false in production)
DEV_SHOW_CODES=true

# Database (Docker Compose sets this for you; only used when running without Docker)
DATABASE_URL=postgres://gather:gather@localhost:5432/gather

# LiveKit media server. Must match deploy/livekit.yaml (keys:) when using Docker Compose.
#  - LIVEKIT_URL is what BROWSERS connect to.
#  - To use LiveKit Cloud's free tier instead: LIVEKIT_URL=wss://<project>.livekit.cloud and its key/secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-for-local-dev-only-0123456789

# AI (free tiers): live captions, translation, summaries, "Ask your meetings"
#  Groq (speech-to-text + text): https://console.groq.com/keys
#  Gemini (text fallback):       https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
AI_URL=http://localhost:8001
# Shared secret between the server and the AI service. Leave empty on a private network (Docker Compose);
# set the same long random value on both when the AI service is reachable from the internet (render.yaml does this).
AI_TOKEN=

# Plans: Free meetings last up to 2 hours
FREE_MEETING_MINUTES=120
PAID_MEETING_MINUTES=1440

# Email. Leave SMTP_HOST empty with Docker Compose (it uses the built-in test inbox at http://localhost:8025).
# For real email, e.g. Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Or send over HTTPS (when SMTP ports are blocked, e.g. Render's free plan): set ONE of these. MAIL_FROM must be a
# sender verified with that service (Brevo: a single sender email is enough; Resend: a verified domain).
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=Gather <no-reply@gather.local>

# WhatsApp Cloud API (optional). Without it, Gather gives one-tap WhatsApp share links instead.
#  https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS via Africa's Talking (optional). Username "sandbox" uses their free sandbox.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Payments (optional). Test keys work: Paystack sk_test_..., Flutterwave FLWSECK_TEST-...
PAYSTACK_SECRET_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
# Fake checkout for trying upgrades with no keys (turn off in production)
DEMO_PAYMENTS=true

# Google Calendar sync (optional). Every host also gets a subscribe link that needs no setup.
# Redirect URI to add in Google Cloud: <APP_URL>/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone dial-in through LiveKit SIP (optional, see docs/DIAL_IN.md)
LIVEKIT_SIP_TRUNK_ID=
DIALIN_NUMBER=

# Admin panel (/admin): the platform admin account, created/updated at start-up.
ADMIN_EMAIL=
ADMIN_PASSWORD=
